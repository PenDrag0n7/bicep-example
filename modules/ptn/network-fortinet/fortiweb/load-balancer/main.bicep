// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

@description('Required. Resource Id for the IP Prefix that Public IP address ranges will be consumed from.')
param publicIpPrefixResourceId string

@description('Optional. Enable Diagnostic Settings for supported resources.')
param diagnosticSettings array = []

// =========================
// Load Balancer Public IP
// =========================

module publicIpAddress 'br/public:avm/res/network/public-ip-address:0.4.0' = {
  name: '${deployment().name}-pip'
  params: {
    name: '${namePrefix}-fortiweb-elb-pip'
    location: location
    diagnosticSettings: [for diagnosticSetting in diagnosticSettings: {
        name: diagnosticSetting.name
        storageAccountResourceId: diagnosticSetting.?storageAccountResourceId
        workspaceResourceId: diagnosticSetting.?workspaceResourceId
      }
    ]
    publicIPAddressVersion: 'IPv4'
    publicIPAllocationMethod: 'Static'
    publicIpPrefixResourceId: publicIpPrefixResourceId
    tags: tags
    zones: [1, 2, 3]
  }
}

// =========================
// Load Balancer - Frontend
// =========================

resource loadBalancer 'Microsoft.Network/loadBalancers@2023-09-01' = {
  name: '${namePrefix}-fortiweb-elb'
  location: location
  sku: {
    name: 'Standard'
  }
  properties: {
    frontendIPConfigurations: [
      {
        properties: {
          publicIPAddress: {
            id: publicIpAddress.outputs.resourceId
          }
        }
        name: '${namePrefix}-fortiweb-elb-fe'
      }
    ]
    backendAddressPools: [
      { name: '${namePrefix}-fortiweb-elb-bp' }
    ]
    loadBalancingRules: [
      {
        properties: {
          frontendIPConfiguration: {
            id: resourceId('Microsoft.Network/loadBalancers/frontendIpConfigurations', '${namePrefix}-fortiweb-elb', '${namePrefix}-fortiweb-elb-fe')
          }
          backendAddressPool: {
            id: resourceId('Microsoft.Network/loadBalancers/backendAddressPools', '${namePrefix}-fortiweb-elb', '${namePrefix}-fortiweb-elb-bp')
          }
          probe: {
            id: resourceId('Microsoft.Network/loadBalancers/probes', '${namePrefix}-fortiweb-elb', '${namePrefix}-fortiweb-elb-hp-80')
          }
          backendPort: 80
          frontendPort: 80
          protocol: 'Tcp'
          disableOutboundSnat: true
          enableFloatingIP: false
          enableTcpReset: false
          loadDistribution: 'SourceIPProtocol'
        }
        name: '${namePrefix}-trust-ilb-lb-80'
      }
      {
        properties: {
          frontendIPConfiguration: {
            id: resourceId('Microsoft.Network/loadBalancers/frontendIpConfigurations', '${namePrefix}-fortiweb-elb', '${namePrefix}-fortiweb-elb-fe')
          }
          backendAddressPool: {
            id: resourceId('Microsoft.Network/loadBalancers/backendAddressPools', '${namePrefix}-fortiweb-elb', '${namePrefix}-fortiweb-elb-bp')
          }
          probe: {
            id: resourceId('Microsoft.Network/loadBalancers/probes', '${namePrefix}-fortiweb-elb', '${namePrefix}-fortiweb-elb-hp-443')
          }
          backendPort: 443
          frontendPort: 443
          protocol: 'Tcp'
          disableOutboundSnat: true
          enableFloatingIP: false
          enableTcpReset: false
          loadDistribution: 'SourceIPProtocol'
        }
        name: '${namePrefix}-trust-ilb-lb-443'
      }
    ]
    probes: [
      {
        properties: {
          intervalInSeconds: 5
          numberOfProbes: 2
          port: 80
          protocol: 'Tcp'
        }
        name: '${namePrefix}-fortiweb-elb-hp-80'
      }
      {
        properties: {
          intervalInSeconds: 5
          numberOfProbes: 2
          port: 443
          protocol: 'Tcp'
        }
        name: '${namePrefix}-fortiweb-elb-hp-443'
      }
    ]
  }
  tags: tags
}

// =========================
// Diagnostic Settings
// =========================

resource diagnosticSettingsLb 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = [for diagnosticSetting in diagnosticSettings: {
  name: diagnosticSetting.name
  scope: loadBalancer
  properties: {
    storageAccountId: diagnosticSetting.?storageAccountResourceId
    workspaceId: diagnosticSetting.?workspaceResourceId
    metrics: [
      {
        category: 'AllMetrics'
        enabled: true
      }
    ]
  }
}]
