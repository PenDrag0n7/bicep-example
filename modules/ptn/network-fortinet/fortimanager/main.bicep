targetScope = 'subscription'

// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

// @description('Optional. Array of role assignments to create.')
// param roleAssignments array = []

// Module specific parameters
@description('Required. Configuration object for the Fortigate resources.')
param fortiManagerConfig object

@description('Required. Existing Virtual Network that will host the networking resources.')
param vnetExisting object

@description('Required. Virtual Machine admin username, extracted from a zone-centric Key Vault.')
@secure()
param vmAdminUsername string

@description('Required. Virtual Machine admin password, extracted from a zone-centric Key Vault.')
@secure()
param vmAdminPassword string

@description('Optional. Enable Diagnostic Settings for supported resources.')
param diagnosticSettings array = []

@description('Optional. Existing Private DNS Zone that will host the A Records for the Management Interface IP.')
param privateDnsZoneExisting object = {}

// FortiManager Image Reference
var imageReference = {
  publisher: 'fortinet'
  offer: 'fortinet-fortimanager'
  sku: 'fortinet-fortimanager'
  version: '7.4.2'
}

// =========================
// Resource Group(s)
// =========================

resource fortiManagerResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' = {
  name: '${namePrefix}-fortimanager-rg'
  location: location
  tags: tags
}

// =========================
// FortiManager VMs
// =========================

module vmsFortiManager 'br/public:avm/res/compute/virtual-machine:0.2.3'= [for (vm, i) in fortiManagerConfig.instanceConfig: {
  name: '${deployment().name}-${vm.name}'
  scope: fortiManagerResourceGroup
  params: {
    name: vm.name
    osType: 'Linux'
    location: location
    availabilityZone: vm.availabilityZone
    imageReference: imageReference
    plan: {
      name: imageReference.sku
      publisher: imageReference.publisher
      product: imageReference.offer
    }
    encryptionAtHost: fortiManagerConfig.?encryptionAtHost ?? false
    vmSize: fortiManagerConfig.vmSize
    adminUsername: vmAdminUsername
    adminPassword: vmAdminPassword
    nicConfigurations: [
      {
        name: 'mgmt'
        nicSuffix: '-nic-mgmt-01'
        enableAcceleratedNetworking: fortiManagerConfig.?enableAcceleratedNetworking ?? true
        diagnosticSettings: [for diagnosticSetting in diagnosticSettings: {
            name: diagnosticSetting.name
            storageAccountResourceId: diagnosticSetting.?storageAccountResourceId
            workspaceResourceId: diagnosticSetting.?workspaceResourceId
          }
        ]
        ipConfigurations: [
          {
            name: 'mgmt-ipconfig-01'
            subnetName: 'sn-mgmt'
            privateIPAddress: vm.ipAddresses.mgmt
            privateIPAllocationMethod: 'static'
            privateIPAddressVersion: 'IPv4'
            subnetResourceId: resourceId(subscription().subscriptionId, vnetExisting.resourceGroupName, 'Microsoft.Network/virtualNetworks/subnets', vnetExisting.name, 'sn-mgmt')
          }
        ]
      }
    ]
    osDisk: {
      diskSizeGB: fortiManagerConfig.osdiskSizeGB
      caching: 'ReadWrite'
      managedDisk: {
        storageAccountType: fortiManagerConfig.storageAccountType
      }
    }
    dataDisks: [
      {
        caching: 'ReadWrite'
        createOption: 'Empty'
        deleteOption: 'Delete'
        diskSizeGB: fortiManagerConfig.datadiskSizeGB
        managedDisk: {
          storageAccountType: fortiManagerConfig.storageAccountType
        }
      }
    ]
    managedIdentities: {
      systemAssigned: true
    }
    bootDiagnostics: true
    enableTelemetry: false
    tags: tags
  }
}]

// =========================
// DNS Records
// =========================

// A Records for hosts
module dnsARecord '../dns-a-record/main.bicep' = [for (vm, i) in fortiManagerConfig.instanceConfig: if (privateDnsZoneExisting != {}) {
  scope: resourceGroup(privateDnsZoneExisting.subscriptionId, privateDnsZoneExisting.resourceGroupName)
  name: '${deployment().name}-dnsarecord-${i}'
  params: {
    hostName: vm.name
    ipv4Address: vm.ipAddresses.mgmt
    privateDnsZone: privateDnsZoneExisting.name
  }
  dependsOn: [
    vmsFortiManager
  ]
}]

// CName Record - fortimanager
module dnsCName '../dns-c-name/main.bicep' = {
  scope: resourceGroup(privateDnsZoneExisting.subscriptionId, privateDnsZoneExisting.resourceGroupName)
  name: '${deployment().name}-dnscname'
  params: {
    cNameRecord: 'fortimanager'
    cNameAlias: '${fortiManagerConfig.instanceConfig[0].name}.${privateDnsZoneExisting.name}'
    privateDnsZone: privateDnsZoneExisting.name
  }
  dependsOn: [
    dnsARecord
  ]
}
