targetScope = 'subscription'
// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

// Module specific parameters
@description('Required. Configuration object for the Fortigate resources.')
param fortiAnalyzerConfig object

@description('Required. Existing Virtual Network that will host the networking resources.')
param vnetExisting object

@description('Required. Virtual Machine admin username, extracted from a zone-centric Key Vault.')
@secure()
param vmAdminUsername string

@description('Required. Virtual Machine admin password, extracted from a zone-centric Key Vault.')
@secure()
param vmAdminPassword string

@description('Optional. Enable Diagnostic Settings for supported resources.')
param diagnosticSettings array = []

@description('Optional. Existing Private DNS Zone that will host the A Records for the Management Interface IP.')
param privateDnsZoneExisting object = {}

// =========================
// Resource Group(s)
// =========================

resource fortiAnalyzerResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' = {
  name: '${namePrefix}-fortianalyzer-rg'
  location: location
  tags: tags
}

// =========================
// Load Balancer - Backend
// =========================

module loadBalancer 'load-balancer/main.bicep' = {
  scope: fortiAnalyzerResourceGroup
  name: '${deployment().name}-ilb'
  params: {
    fortiAnalyzerConfig: fortiAnalyzerConfig
    location: location
    namePrefix: namePrefix
    vnetExisting: vnetExisting
    diagnosticSettings: diagnosticSettings
    tags: tags
  }
}

// =========================
// FortiAnalyzer VMs
// =========================

module vmsFortiAnalyzer 'virtual-machine/main.bicep' = {
  scope: fortiAnalyzerResourceGroup
  name: '${deployment().name}-vm'
  params: {
    fortiAnalyzerConfig: fortiAnalyzerConfig
    location: location
    namePrefix: namePrefix
    vmAdminPassword: vmAdminPassword
    vmAdminUsername: vmAdminUsername
    vnetExisting: vnetExisting
    tags: tags
  }
  dependsOn: [
    loadBalancer
  ]
}

// =========================
// DNS - A Records
// =========================

module dns '../dns-a-record/main.bicep' = [for (vm, i) in fortiAnalyzerConfig.instanceConfig: if (privateDnsZoneExisting != {}) {
  scope: resourceGroup(privateDnsZoneExisting.subscriptionId, privateDnsZoneExisting.resourceGroupName)
  name:'${deployment().name}-dnsarecord-${i}'
  params: {
    hostName: vm.name
    ipv4Address: vm.ipAddresses.mgmt
    privateDnsZone: privateDnsZoneExisting.name
  }
  dependsOn: [
    vmsFortiAnalyzer
  ]
}]

module dnsIlb '../dns-a-record/main.bicep' = {
  scope: resourceGroup(privateDnsZoneExisting.subscriptionId, privateDnsZoneExisting.resourceGroupName)
  name:'${deployment().name}-dnsarecord-ilb'
  params: {
    hostName: 'fortianalyzer'
    ipv4Address: fortiAnalyzerConfig.loadBalancerConfig.ipAddress
    privateDnsZone: privateDnsZoneExisting.name
  }
  dependsOn: [
    loadBalancer
  ]
}
