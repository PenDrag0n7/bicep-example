targetScope = 'subscription'

// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Required. Name of the resource group that will be created to host the pattern resources.')
param resourceGroupName string

@description('''
Optional. Log Analytics Workspace settings. If not provided, default settings will be used.
Example input:
{
  "skuName": "PerGB2018",
  "dataRetention": 30,
  "publicNetworkAccessForIngestion": "Enabled",
  "publicNetworkAccessForQuery": "Enabled"
  "useResourcePermissions": true
}
''')
param logAnalyticsConfig object = {}

@description('Optional. If false, the Entity Analytics settings will be skipped, Use this as a workaround for ETAG errors.')
param enableEntityAnalytics bool = true

@description('Optional. If false, the User and Entity Behavior Analytics settings will be skipped, Use this as a workaround for ETAG errors.')
param enableUeba bool = true

@description('Optional: List of Entra ID logs to be collected. Defaults to all logs.')
param aadLogCategories array = [
  'AuditLogs'
  'SignInLogs'
  'NonInteractiveUserSignInLogs'
  'ServicePrincipalSignInLogs'
  'ManagedIdentitySignInLogs'
  'ProvisioningLogs'
  'RiskyUsers'
  'UserRiskEvents'
  'NetworkAccessTrafficLogs'
  'RiskyServicePrincipals'
  'ServicePrincipalRiskEvents'
  'EnrichedOffice365AuditLogs'
  'MicrosoftGraphActivityLogs'
  'RemoteNetworkHealthLogs'
]

@description('Optional. Array of role assignments to create.')
param logAnalyticsRoleAssignments array = []

// =========================
// Resource Group(s)
// =========================

resource sentinelResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' = {
  name: resourceGroupName
  location: location
  tags: tags
}

// =========================
// Log Analytics Workspace
// =========================

module logAnalytics 'br/public:avm/res/operational-insights/workspace:0.3.3' = {
  name: '${deployment().name}-law'
  scope: sentinelResourceGroup
  params: {
    enableTelemetry: false
    name: '${namePrefix}-law'
    location: location
    roleAssignments: logAnalyticsRoleAssignments
    skuName: contains(logAnalyticsConfig, 'skuName') ? logAnalyticsConfig.skuName : 'PerGB2018'
    dataRetention: contains(logAnalyticsConfig, 'dataRetention') ? logAnalyticsConfig.dataRetention : 90
    publicNetworkAccessForIngestion: contains(logAnalyticsConfig, 'publicNetworkAccessForIngestion') ? logAnalyticsConfig.publicNetworkAccessForIngestion : 'Enabled'
    publicNetworkAccessForQuery: contains(logAnalyticsConfig, 'publicNetworkAccessForQuery') ? logAnalyticsConfig.publicNetworkAccessForQuery : 'Enabled'
    useResourcePermissions: contains(logAnalyticsConfig, 'useResourcePermissions') ? logAnalyticsConfig.useResourcePermissions : true
    tags: tags
  }
}

// =========================
// Sentinel Solution
// =========================

module sentinel 'br/public:avm/res/operations-management/solution:0.1.2' = {
  name: '${deployment().name}-solution'
  scope: sentinelResourceGroup
  params: {
    enableTelemetry: false
    logAnalyticsWorkspaceName: logAnalytics.outputs.name
    name: 'SecurityInsights'
    publisher: 'Microsoft'
    product: 'OMSGallery'
  }
}

// =========================
// Sentinel Settings
// =========================

module settingsEa 'settings/main.bicep' = if (enableEntityAnalytics == true) {
  name: '${deployment().name}-settings-ea'
  scope: sentinelResourceGroup
  params: {
    settingsKind: 'EntityAnalytics'
    logAnalyticsWorkspaceName: logAnalytics.outputs.name
  }
  dependsOn: [
    sentinel
  ]
}

module settingsUeba 'settings/main.bicep' = if (enableUeba == true) {
  name: '${deployment().name}-settings-ueba'
  scope: sentinelResourceGroup
  params: {
    settingsKind: 'Ueba'
    logAnalyticsWorkspaceName: logAnalytics.outputs.name
  }
  dependsOn: [
    sentinel
    settingsEa
  ]
}

// =========================
// Sentinel Connectors
// =========================

module connectorOffice365 'connectors/main.bicep' = {
  scope: sentinelResourceGroup
  name: '${deployment().name}-connector-o365'
  params: {
    connector: 'Office365'
    logAnalyticsWorkspaceName: logAnalytics.outputs.name
  }
  dependsOn: [
    sentinel
    settingsEa
    settingsUeba
  ]
}

module connectorMicrosoftCloudAppSecurity 'connectors/main.bicep' = {
  scope: sentinelResourceGroup
  name: '${deployment().name}-connector-mcas'
  params: {
    connector: 'MicrosoftCloudAppSecurity'
    logAnalyticsWorkspaceName: logAnalytics.outputs.name
  }
  dependsOn: [
    sentinel
    settingsEa
    settingsUeba
  ]
}

module connectorAzureATP 'connectors/main.bicep' = {
  scope: sentinelResourceGroup
  name: '${deployment().name}-connector-azatp'
  params: {
    connector: 'AzureAdvancedThreatProtection'
    logAnalyticsWorkspaceName: logAnalytics.outputs.name
  }
  dependsOn: [
    sentinel
    settingsEa
    settingsUeba
  ]
}

resource aadDiagnosticSetttings 'microsoft.aadiam/diagnosticSettings@2017-04-01' = if (!empty(aadLogCategories)) {
  scope: tenant()
  name: 'aadDiagnosticSetttings'
  properties: {
    workspaceId: logAnalytics.outputs.resourceId
    logs: [for log in aadLogCategories: {
      category: log
      enabled: true
    }]
  }
  dependsOn: [
    logAnalytics
  ]
}
