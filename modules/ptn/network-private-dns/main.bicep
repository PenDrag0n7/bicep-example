targetScope = 'subscription'

metadata name = 'Pattern - Private DNS'
metadata description = 'This module deploys the foundational components of Private DNS.'
metadata owner = 'Platform team'

// =========================
// Parameters
// =========================

// Common Parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Required. Name of the resource group that will be created to host the pattern resources.')
param resourceGroupName string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

@description('Optional. Array of role assignments to create.')
param roleAssignments array = []

// Module Specific Parameters
@description('Required. Array of custom private DNS zone names.')
param customDnsZoneNames customDnsZoneNameType

@description('Optional. Shared list of Azure private endpoint private DNS zone names.')
param privateEndpointDnsZoneNames array = []

@description('Required. Private IP address of the inbound endpoint.')
param dnsResolverInboundEndpointIPAddress string

@description('Required. The virtual network that contains the subnet to host the NIC.')
param vnetExisting vnetExistingType

@description('Optional. Array of DNS forwarding rules for the private DNS resolver.')
param forwardingRules forwardingRuleType = []

param deployAllPrivateEndpointZones bool = true

// =========================
// Existing Resources
// =========================

resource virtualNetwork 'Microsoft.Network/virtualNetworks@2023-04-01' existing = {
  name: vnetExisting.name
  scope: resourceGroup(vnetExisting.resourceGroupName)
}

resource inboundEndpointSubnet 'Microsoft.Network/virtualNetworks/subnets@2023-04-01' existing = {
  name: 'sn-dns-in'
  parent: virtualNetwork
}

resource outboundEndpointSubnet 'Microsoft.Network/virtualNetworks/subnets@2023-04-01' existing = {
  name: 'sn-dns-out'
  parent: virtualNetwork
}

// =========================
// Resource Group(s)
// =========================

resource dnsResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' = {
  name: resourceGroupName
  location: location
  tags: tags
}

// =========================
// Resource Group RBAC
// =========================

module rgRoleAssignments '../../res/authorization-role-assignment-rg/main.bicep' = [
  for (roleAssignment, i) in roleAssignments: {
    name: '${deployment().name}-roleassignments-${i}'
    scope: dnsResourceGroup
    params: {
      roleAssignment: roleAssignment
    }
  }
]

// =========================
// Private DNS Zone(s)
// =========================

// Private Endpoint Private DNS Zones

module currentZones 'endpoint-zones/main.bicep' = if (deployAllPrivateEndpointZones) {
  name: '${deployment().name}-zonelist'
  scope: dnsResourceGroup
}

module privateEndpointPrivateDnsZones 'br/public:avm/res/network/private-dns-zone:0.2.5' = [
  for (privateDnsDomainName, i) in privateEndpointDnsZoneNames: {
    name: '${deployment().name}-pepdz-${i}'
    scope: dnsResourceGroup
    params: {
      name: privateDnsDomainName
      virtualNetworkLinks: [
        {
          privateDnsZoneName: privateDnsDomainName
          virtualNetworkResourceId: virtualNetwork.id
          registrationEnabled: false
        }
      ]
    }
  }
]

// Custom Private DNS Zones
module customPrivateDnsZones 'br/public:avm/res/network/private-dns-zone:0.2.5' = [
  for (customDnsDomainName, i) in customDnsZoneNames: {
    name: '${deployment().name}-cpdz-${i}'
    scope: dnsResourceGroup
    params: {
      name: customDnsDomainName.name
      virtualNetworkLinks: [
        {
          privateDnsZoneName: customDnsDomainName.name
          virtualNetworkResourceId: virtualNetwork.id
          registrationEnabled: customDnsDomainName.registrationEnabled
        }
      ]
    }
  }
]

// =========================
// DNS Resolver
// =========================

module dnsResolver 'br/public:avm/res/network/dns-resolver:0.3.0' = {
  name: '${deployment().name}-dns-resolver'
  scope: dnsResourceGroup
  params: {
    name: '${namePrefix}-rsv'
    virtualNetworkResourceId: virtualNetwork.id
    inboundEndpoints: [
      {
        name: '${namePrefix}-iep'
        subnetResourceId: inboundEndpointSubnet.id
        privateIpAddress: dnsResolverInboundEndpointIPAddress
        privateIpAllocationMethod: 'Static'
      }
    ]
    outboundEndpoints: [
      {
        name: '${namePrefix}-oep'
        subnetResourceId: outboundEndpointSubnet.id
      }
    ]
  }
}

// =========================
// DNS Forwarding Ruleset
// =========================

module dnsForwardingRuleset 'br/public:avm/res/network/dns-forwarding-ruleset:0.2.5' = {
  name: '${deployment().name}-dns-fr'
  scope: dnsResourceGroup
  params: {
    name: '${namePrefix}-dnsfr'
    dnsForwardingRulesetOutboundEndpointResourceIds: [
      resourceId(subscription().subscriptionId, dnsResourceGroup.name, 'Microsoft.Network/dnsResolvers/outboundEndpoints', '${namePrefix}-rsv', '${namePrefix}-oep')
    ]
    forwardingRules: forwardingRules
    virtualNetworkLinks: [{
      virtualNetworkResourceId: virtualNetwork.id
    }]
  }
  dependsOn: [dnsResolver]
}

// =========================
// User-Defined Types
// =========================

type vnetExistingType = {
  name: string
  resourceGroupName: string
}

type customDnsZoneNameType = {
  name: string
  registrationEnabled: bool
}[]

type forwardingRuleType = {
  @description('Required. The name of the forwarding rule.')
  name: string

  @description('Optional. The state of the forwarding rule.')
  forwardingRuleState: ('Enabled' | 'Disabled')?

  @description('Required. The domain name to forward.')
  domainName: string

  @description('Required. The target DNS servers to forward to.')
  targetDnsServers: targetDnsServers

  @description('Optional. Metadata attached to the forwarding rule.')
  metadata: string?
}[]

type targetDnsServers = {
  @description('Required. The IP address of the target DNS server.')
  ipAddress: string

  @description('Required. The port of the target DNS server.')
  port: string
}[]
