targetScope = 'subscription'

// =========================
// Parameters
// =========================

// Common parameters
@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. Name of the resource group that will be created to host the pattern resources.')
param resourceGroupName string

// Module specific parameters
@description('Required: The name of the Virtual Network that contains the subnets for the Virtual Machines.')
param vnetExisting object

@description('Required. Key Vault name where the VM admin username and password are stored.')
param keyVaultExisting object

@description('Required. Specification of DCR data flows.')
param dataFlows array

@description('Required. Specification of data sources that will be collected by the DCR.')
param dataSources object

@description('Required. Specification of destinations that can be used in DCR data flows.')
param destinations object

@description('Required. The private IP address to assign to the internal load balancer. If not specified, a dynamic IP address will be assigned.')
param ilbIpAddress string

@description('Optional. The diagnostic setting to apply to the resources.')
param diagnosticSettings object?

// =========================
// Resource Group
// =========================

resource syslogResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' = {
  name: resourceGroupName
  location: location
}

// =========================
// Existing Resources
// =========================

resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' existing = {
  name: keyVaultExisting.name
  scope: resourceGroup(keyVaultExisting.?resourceGroupName ?? resourceGroupName)
}

// =========================
// Load Balancer
// =========================

module syslogLoadBalancer './load-balancer/main.bicep' = {
  name: '${deployment().name}-syslog-lb'
  scope: syslogResourceGroup
  params: {
    location: location
    namePrefix: namePrefix
    vnetExisting: vnetExisting
    ilbIpAddress: ilbIpAddress
    diagnosticSettings: diagnosticSettings
  }
}

// =========================
// Virtual Machine Scale Set
// =========================

module syslogVmScaleSet './vmss/main.bicep' = {
  name: '${deployment().name}-syslog-vmss'
  scope: syslogResourceGroup
  params:{
    location: location
    namePrefix: namePrefix
    vmAdminUsername: keyVault.getSecret('vmAdminUsername-Common')
    vmAdminPassword: keyVault.getSecret('vmAdminPassword-Common')
    vnetExisting: vnetExisting
  }
  dependsOn:[
    syslogLoadBalancer
  ]
}

// =========================
// Data Collection Rule
// =========================

module syslogDataCollectionRule 'br/public:avm/res/insights/data-collection-rule:0.1.2' = {
  name: '${deployment().name}-syslog-dcr'
  scope: syslogResourceGroup
  params: {
    enableTelemetry: false // Disable Microsoft standard telemetry on the deployments
    name: '${namePrefix}-dcr'
    dataFlows: dataFlows
    dataSources: dataSources
    destinations: destinations
  }
}

module syslogDataCollectionRuleAssociation './dcr-association/main.bicep' = {
  name: '${deployment().name}-syslog-dcra'
  scope: syslogResourceGroup
  params: {
    dataCollectionRuleId: syslogDataCollectionRule.outputs.resourceId
    vmssName: syslogVmScaleSet.outputs.vmssName
  }
}
