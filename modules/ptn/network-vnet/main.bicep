targetScope = 'subscription'

metadata name = 'Pattern - Virtual Network Baseline'
metadata description = 'This module deploys a basic set of networking components into each zone.'
metadata owner = 'Platform team'

// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Required. Name of the resource group that will be created to host the pattern resources.')
param resourceGroupName string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

@description('Optional. Array of role assignments to create.')
param roleAssignments array = []

// Networking parameters
@description('Required. Array of CIDR ranges that will be assigned to the VNet.')
param vnetAddressPrefixes array

@description('Optional. Array of DNS Servers to use within the VNet.')
param vnetDnsServers array = []

@description('Optional. Array of subnets that will be created within the VNet.')
param vnetSubnets array = []

@description('Optional. Array of peerings for the VNet.')
param vnetPeerings array = []

@description('Optional. Indicates if encryption is enabled on virtual network and if VM without encryption is allowed in encrypted VNet.')
param vnetEncryption bool = false

@description('Optional. Enables NSG Flow logs on any NSG that is created and assigned to subnets within this pattern. Requires flowLogSettings to be supplied.')
param enableNsgFlowLogs bool = false

@description('Optional. Resource ID of the DDoS protection plan to assign the VNET to. If its left blank, DDoS protection will not be configured.')
param ddosProtectionPlanResourceId string = ''

@description('Optional. An array of routes to be established within the route table. By default empty route table will be created and attached to each subnet.')
param routeTables array = [
  { name: 'default' }
]

@description('Optional. An array of diagnostic settings to apply to applicable resources.')
param diagnosticSettings array = []

@description('Optional. An object containing the logging storage account that the flow logs will be stored in.')
param flowLogSettings object = {}

@description('Optional. Create a Network Watcher resource if one does not already exist for the subscription and region.')
param createNetworkWatcher bool = true

@description('Optional. Length of the Public IP Prefix. Value must be between 28 and 31 inclusive.')
param publicIpPrefixLength string = ''

// =========================
// Resource Group(s)
// =========================

resource networkResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' = {
  name: resourceGroupName
  location: location
  tags: tags
}

// =========================
// Resource Group RBAC
// =========================

module rgRoleAssignments '../../res/authorization-role-assignment-rg/main.bicep' = [for (roleAssignment, i) in roleAssignments: {
  name: '${deployment().name}-roleassignments-${i}'
  scope: networkResourceGroup
  params: {
    roleAssignment: roleAssignment
  }
}]

// =========================
// Network Watcher
// =========================

module networkWatcher './network-watchers/main.bicep' = if (createNetworkWatcher == true) {
  name: '${deployment().name}-networkwatcher-${location}'
  scope: networkResourceGroup
  params: {
    tags: tags
    locations: [location]
  }
}

// =========================
// Route Tables
// =========================

module baseRouteTables 'br/public:avm/res/network/route-table:0.2.2' = [for routeTable in routeTables: if (vnetSubnets != []) {
  name: '${deployment().name}-routetable-${routeTable.name}'
  scope: networkResourceGroup
  params: {
    name: '${namePrefix}-${routeTable.name}-rt'
    location: location
    routes: contains(routeTable, 'routes') ? routeTable.routes : []
    disableBgpRoutePropagation: contains(routeTable, 'disableBgpRoutePropagation') ? routeTable.disableBgpRoutePropagation : false
    enableTelemetry: false
    tags: tags
  }
}]

// =========================
// Network Security Groups
// =========================

module networkSecurityGroups 'br/public:avm/res/network/network-security-group:0.1.3' = [for (subnet, i) in vnetSubnets: if (subnet.assignNsg == true) {
  name: '${deployment().name}-nsg-${subnet.name}'
  scope: networkResourceGroup
  params: {
    name: '${namePrefix}-${subnet.name}-nsg'
    location: location
    securityRules: contains(subnet, 'securityRules') ? subnet.securityRules : []
    diagnosticSettings: diagnosticSettings
    enableTelemetry: false
    tags: tags
  }
}]

// =========================
// Virtual Network
// =========================

module virtualNetwork '../../res/network-virtual-network/main.bicep' = {
  name: '${deployment().name}-vnet'
  scope: networkResourceGroup
  params: {
    name: '${namePrefix}-vnet'
    location: location
    dnsServers: vnetDnsServers
    addressPrefixes: vnetAddressPrefixes
    vnetEncryption: vnetEncryption
    peerings: [ for peering in vnetPeerings: {
        name: '${namePrefix}-vnet-to-${last(split(peering.remoteVirtualNetworkId, '/'))}'
        remotePeeringName: '${last(split(peering.remoteVirtualNetworkId, '/'))}-to-${namePrefix}-vnet'
        remoteVirtualNetworkId: peering.remoteVirtualNetworkId
        allowForwardedTraffic: contains(peering, 'allowForwardedTraffic') ? peering.allowForwardedTraffic : false
        allowGatewayTransit: contains(peering, 'allowGatewayTransit') ? peering.allowGatewayTransit : false
        allowVirtualNetworkAccess: contains(peering, 'allowVirtualNetworkAccess') ? peering.allowVirtualNetworkAccess : true
        remotePeeringAllowForwardedTraffic: contains(peering, 'remotePeeringAllowForwardedTraffic') ? peering.remotePeeringAllowForwardedTraffic : true
        remotePeeringAllowVirtualNetworkAccess: contains(peering, 'remotePeeringAllowVirtualNetworkAccess') ? peering.remotePeeringAllowVirtualNetworkAccess : true
        remotePeeringEnabled: contains(peering, 'remotePeeringEnabled') ? peering.remotePeeringEnabled : true
        useRemoteGateways: contains(peering, 'useRemoteGateways') ? peering.useRemoteGateways : false
      }
    ]
    ddosProtectionPlanResourceId: ddosProtectionPlanResourceId
    diagnosticSettings: diagnosticSettings
    tags: tags
    subnets: [for (subnet, i) in vnetSubnets: {
      name: subnet.name
      virtualNetworkName: '${namePrefix}-vnet'
      addressPrefix: subnet.addressPrefix
      addressPrefixes: contains(subnet, 'addressPrefixes') ? subnet.addressPrefixes : []
      applicationGatewayIPConfigurations: contains(subnet, 'applicationGatewayIPConfigurations') ? subnet.applicationGatewayIPConfigurations : []
      delegations: contains(subnet, 'delegations') ? subnet.delegations : []
      privateEndpointNetworkPolicies: contains(subnet, 'privateEndpointNetworkPolicies') ? subnet.privateEndpointNetworkPolicies : 'Disabled'
      privateLinkServiceNetworkPolicies: contains(subnet, 'privateLinkServiceNetworkPolicies') ? subnet.privateLinkServiceNetworkPolicies : 'Disabled'
      routeTableResourceId: contains(subnet, 'routeTable') ? resourceId(subscription().subscriptionId, networkResourceGroup.name, 'Microsoft.Network/routeTables', '${namePrefix}-${subnet.routeTable}-rt') : ''
      networkSecurityGroupResourceId: subnet.assignNsg ? resourceId(subscription().subscriptionId, networkResourceGroup.name, 'Microsoft.Network/networkSecurityGroups', '${namePrefix}-${subnet.name}-nsg') : ''
      serviceEndpoints: contains(subnet, 'serviceEndpoints') ? subnet.serviceEndpoints : []
      serviceEndpointPolicies: contains(subnet, 'serviceEndpointPolicies') ? subnet.serviceEndpointPolicies : []
    }]
  }
  dependsOn: [
    baseRouteTables
    networkWatcher
    networkSecurityGroups
  ]
}

// =========================
// Flow Logs
// =========================

module flowLogs './flow-logs/main.bicep'  = [for nsg in vnetSubnets: if (flowLogSettings != {} && enableNsgFlowLogs == true && nsg.assignNsg == true) {
  name: '${deployment().name}-flowlogs-${nsg.name}'
  scope: networkResourceGroup
  params: {
    nsgName: nsg.name
    location: location
    namePrefix: namePrefix
    tags: tags
    flowLogSettings: flowLogSettings
  }
  dependsOn: [
    virtualNetwork
    networkSecurityGroups
  ]
}]

// =========================
// Public IP Prefix
// =========================

module publicIpPrefix 'br/public:avm/res/network/public-ip-prefix:0.3.0' = if (!empty(publicIpPrefixLength)) {
  name: '${deployment().name}-pippfx'
  scope: networkResourceGroup
  params: {
    name: '${namePrefix}-pfx'
    location: location
    prefixLength: int(publicIpPrefixLength)
    enableTelemetry: false
    zones: [1, 2, 3]
    tags: tags
  }
}
