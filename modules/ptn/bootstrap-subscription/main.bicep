targetScope = 'subscription'

metadata name = 'Pattern - Zone Bootstrap'
metadata description = 'This module deploys the baseline requirements for each Zone subscription.'
metadata owner = 'Platform team'

// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Required. Name of the resource group that will be created to host the pattern resources.')
param resourceGroupName string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

@description('Optional. Array of role assignments to apply to the Key Vault.')
param roleAssignments object = {}

// =========================
// Subscription Tags
// =========================

resource applyTags 'Microsoft.Resources/tags@2023-07-01' = {
  name: 'default'
  properties: {
    tags: tags
  }
}

// =========================
// Resource Group(s)
// =========================

resource bootstrapResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' = {
  name: resourceGroupName
  location: location
  tags: tags
}

// =========================
// Key Vault - Shared
// =========================

module keyVaultShared 'br/public:avm/res/key-vault/vault:0.5.0' = { // To do - Private Endpoints, etc
  name: '${deployment().name}-key-vault'
  scope: bootstrapResourceGroup
  params: {
    name: '${take(replace(namePrefix, '-', ''), 21)}-kv'
    roleAssignments: roleAssignments.?keyVault ?? null
    networkAcls: {
      defaultAction: 'deny'
    }
  }
}

// =========================
// Storage Account - Shared
// =========================

module storageAccountShared 'br/public:avm/res/storage/storage-account:0.8.0' = {  // To do - Private Endpoints, etc
  name: '${deployment().name}-storage-account'
  scope: bootstrapResourceGroup
  params: {
    name: '${take(replace(namePrefix, '-', ''), 22)}sa'
    roleAssignments: roleAssignments.?storageAccount ?? null
    networkAcls: {
      defaultAction: 'Deny'
      bypass: 'None'
    }
  }
}
