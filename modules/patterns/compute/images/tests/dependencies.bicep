// =========================
// Parameters
// =========================

@description('Optional. The location to deploy to.')
param location string = resourceGroup().location

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

// =========================
// Virtual Networks
// =========================

module hubVirtualNetwork 'br/public:avm/res/network/virtual-network:0.1.5' = {
  name: '${deployment().name}-hub'
  params: {
    name: '${namePrefix}-vnet'
    location: location
    addressPrefixes: ['10.68.8.0/21']
    subnets: [
      {
        name: 'sn-container-registry'
        addressPrefix: '10.68.8.0/23'
        assignNsg: true
        privateEndpointNetworkPolicies: 'Enabled'
      }
    ]
  }
}

module logAnalytics 'br/public:avm/res/operational-insights/workspace:0.3.3' = {
  name: '${deployment().name}-dep-law'
  params: {
    enableTelemetry: false
    name: '${namePrefix}-law'
    location: location
  }
}

resource privateDnsZone 'Microsoft.Network/privateDnsZones@2020-06-01' = {
  name: 'privatelink.azurecr.io'
  location: 'global'
}

output subnetResourceId array = hubVirtualNetwork.outputs.subnetResourceIds
output workspaceResourceId string = logAnalytics.outputs.resourceId
