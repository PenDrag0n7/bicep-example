targetScope = 'subscription'

// =========================
// Parameters
// =========================

// Common parameters
@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

// =========================
// Resource Group(s)
// =========================

resource syslogResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' existing = {
  name: '${namePrefix}-rg'
}

// =========================
// Public Prefixes
// =========================

module syslogPublicIpPrefix 'br/public:avm/res/network/public-ip-prefix:0.3.0' = {
  name: '${deployment().name}-syslog-pipprefix'
  scope: syslogResourceGroup
  params: {
    name: '${namePrefix}-pipprefix'
    prefixLength: 30
  }
}
