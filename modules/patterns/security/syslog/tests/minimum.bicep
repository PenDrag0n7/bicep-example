targetScope = 'subscription'

// =========================
// Parameters
// =========================

@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string = deployment().location

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string = '${take(uniqueString(deployment().name, location), 6)}-syslog'

@secure()
@description('Required. VMSS instance account username.')
param adminUsername string = 'vmssadmin'

@secure()
@description('Required. VMSS instance account password.')
param adminPassword string

// =========================
// Resource Group(s)
// =========================

resource syslogResourceGroup 'Microsoft.Resources/resourceGroups@2022-09-01' = {
  name: '${namePrefix}-rg'
  location: location
}

// =========================
// Dependencies
// =========================

module virtualNetwork '../../../../resources/network/virtual-network/main.bicep' = {
  name: '${deployment().name}-vnet'
  scope: syslogResourceGroup
  params: {
    name: '${namePrefix}-vnet'
    location: location
    addressPrefixes: ['10.68.12.0/23']
    subnets: [
      {
        name: 'sn-syslog'
        addressPrefix: '10.68.12.0/27'
        assignNsg: true
        routeTable: 'baseline'
      }
      {
        name: 'AzureBastionSubnet'
        addressPrefix: '10.68.12.32/27'
      }
    ]
  }
}

module logAnalytics 'br/public:avm/res/operational-insights/workspace:0.3.3' = {
  name: '${deployment().name}-law'
  scope: syslogResourceGroup
  params: {
    enableTelemetry: false
    name: '${namePrefix}-law'
    location: location
    skuName: 'PerGB2018'
    dataRetention: 30
    publicNetworkAccessForIngestion: 'Enabled'
    publicNetworkAccessForQuery: 'Enabled'
  }
}

module syslogKeyVault 'br/public:avm/res/key-vault/vault:0.4.0' = {
  name: '${deployment().name}-kv'
  scope: syslogResourceGroup
  params: {
    name: '${namePrefix}-keyvault'
    secrets: {
      secureList: [
        {
          name: 'vmAdminUsername-Common'
          value: adminUsername
        }
        {
          name: 'vmAdminPassword-Common'
          value: adminPassword
        }
      ]
    }
  }
}

// =========================
// Test - Minimum Params
// =========================

module patternTest '../main.bicep' = {
  name: '${deployment().name}-vmss'
  params: {
    keyVaultExisting : {
      name: syslogKeyVault.outputs.name
    }
    namePrefix: namePrefix
    location: location
    resourceGroupName: syslogResourceGroup.name
    ilbIpAddress: '10.68.12.20'
    diagnosticSettings: {
      workspaceResourceId: logAnalytics.outputs.logAnalyticsWorkspaceId
    }
    vnetExisting: {
      name: '${namePrefix}-vnet'
      resourceGroupName: '${namePrefix}-rg'
    }
    dataFlows: [
      {
        streams: [
          'Microsoft-Syslog'
        ]
        destinations: [
          'syslogWorkspace'
        ]
      }
    ]
    dataSources: {
      syslog: [
        {
          facilityNames: [
            '*'
          ]
          logLevels: [
            'Warning'
            'Error'
            'Critical'
            'Alert'
            'Emergency'
          ]
          name: 'syslogDataSource'
          streams: [
            'Microsoft-Syslog'
          ]
        }
      ]
    }
    destinations: {
      logAnalytics: [
        {
          workspaceResourceId: resourceId(subscription().subscriptionId, syslogResourceGroup.name, 'Microsoft.OperationalInsights/workspaces', '${namePrefix}-law')
          name: 'syslogWorkspace'
        }
      ]
    }
  }
  dependsOn: [logAnalytics]
}

output resourceGroupName string = syslogResourceGroup.name
output keyVaultName string = syslogKeyVault.outputs.name
