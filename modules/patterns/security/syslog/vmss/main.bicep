targetScope = 'resourceGroup'

metadata name = 'Virtual Machine Set'
metadata description = 'This module deploys Virtual Machine Scale Sets.'
metadata owner = 'Platform team'
metadata reference = 'https://learn.microsoft.com/en-us/azure/templates/microsoft.compute/virtualmachinescalesets?pivots=deployment-language-bicep'

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. Existing Virtual Network that will host the networking resources.')
param vnetExisting object

@description('Required. Virtual Machine Scale Set admin username, extracted from a zone-centric Key Vault.')
@secure()
param vmAdminUsername string

@description('Required. Virtual Machine Scale Set admin password, extracted from a zone-centric Key Vault.')
@secure()
param vmAdminPassword string

@description('Required. The virtual machine scale set sku.')
param skuName string = 'Standard_B4ms'

@description('Required. Cloudinit file to run when VMSS instance is provisioned.')
param script string = loadTextContent('../scripts/cloudinit')
/*
If the ../scripts/Forwarder_AMA_Installer.py script is modified/updated, use https://www.base64encode.org/ to re-encode to Base64 (ensure UTF8 and and LF UNIX
newline separator set). Use the encoded data in the ../scripts/cloudinit file
*/

@description('Required. Base64 encoded Cloudinit script value.')
param cloudinit string = base64(script)

// =========================
// Virtual Machine Scale Set
// =========================

resource virtualMachineScaleSet 'Microsoft.Compute/virtualMachineScaleSets@2023-09-01' = {
  name: '${namePrefix}-vmss'
  location: location
  sku: {
    name: skuName
    tier: 'Standard'
    capacity: 2
  }
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    upgradePolicy: {
      mode: 'Automatic'
      automaticOSUpgradePolicy: {
        enableAutomaticOSUpgrade: true
      }
    }
    virtualMachineProfile: {
      storageProfile: {
        osDisk: {
          caching: 'ReadWrite'
          createOption: 'FromImage'
        }
        imageReference: {
          offer: '0001-com-ubuntu-server-jammy'
          publisher: 'Canonical'
          sku: '22_04-lts'
          version: 'latest'
        }
      }
      osProfile: {
        computerNamePrefix: '${namePrefix}-vmss'
        adminUsername: vmAdminUsername
        adminPassword: vmAdminPassword
        customData: cloudinit
        linuxConfiguration: {
          provisionVMAgent: true
          disablePasswordAuthentication: false
        }
      }
      diagnosticsProfile: {
        bootDiagnostics: {
          enabled: true
        }
      }
      networkProfile: {
        networkInterfaceConfigurations: [
          {
            name: 'nic-management-01'
            properties: {
              primary: true
              ipConfigurations: [
                {
                  name: 'ipconfig01'
                  properties: {
                    subnet: {
                      id: resourceId(subscription().subscriptionId, vnetExisting.resourceGroupName, 'Microsoft.Network/virtualNetworks/subnets', vnetExisting.name, 'sn-syslog')
                    }
                    privateIPAddressVersion: 'IPv4'
                    loadBalancerBackendAddressPools: [
                      {
                        id: resourceId(subscription().subscriptionId, resourceGroup().name, 'Microsoft.Network/loadBalancers/backendAddressPools', '${namePrefix}-ilb', '${namePrefix}-ilb-bp')
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
      extensionProfile: {
        extensions: [
          {
            name: 'AzureMonitorAgent'
            properties: {
              publisher: 'Microsoft.Azure.Monitor'
              type: 'AzureMonitorLinuxAgent'
              typeHandlerVersion: '1.6'
              autoUpgradeMinorVersion: true
            }
          }
          {
            name: 'HealthExtension'
            properties: {
              publisher: 'Microsoft.ManagedServices'
              type: 'ApplicationHealthLinux'
              typeHandlerVersion: '1.0'
              autoUpgradeMinorVersion: true
              settings: {
                protocol: 'tcp'
                port: 22
                intervalInSeconds: 5
                numberOfProbes: 1
              }
            }
          }
        ]
      }
    }
  }
}

output vmssName string = virtualMachineScaleSet.name
