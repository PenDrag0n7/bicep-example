@description('Optional. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string = resourceGroup().location

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Required. Existing Virtual Network that will host the networking resources.')
param vnetExisting object

@description('Required. The private IP address to assign to the internal load balancer. If not specified, a dynamic IP address will be assigned.')
param ilbIpAddress string

@description('Optional. The diagnostic settings to apply to the load balancer.')
param diagnosticSettings object?

// =========================
// Load Balancer
// =========================

resource loadBalancer 'Microsoft.Network/loadBalancers@2023-04-01' = {
  name: '${namePrefix}-ilb'
  location: location
  sku: {
    name: 'Standard'
  }
  properties: {
    backendAddressPools: [
      { name: '${namePrefix}-ilb-bp' }
    ]
    frontendIPConfigurations: [
      {
        name: '${namePrefix}-ilb-fe'
        properties: {
          privateIPAddress: ilbIpAddress
          privateIPAllocationMethod: 'Static'
          subnet: {
            id: resourceId(subscription().subscriptionId, vnetExisting.resourceGroupName, 'Microsoft.Network/virtualNetworks/subnets', vnetExisting.name, 'sn-syslog')
          }
        }
      }
    ]
    loadBalancingRules: [
      {
        name: '${namePrefix}-ilb-lb'
        properties: {
          backendAddressPool: {
            id: resourceId('Microsoft.Network/loadBalancers/backendAddressPools', '${namePrefix}-ilb', '${namePrefix}-ilb-bp')
          }
          backendPort: 514
          frontendIPConfiguration: {
            id: resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', '${namePrefix}-ilb', '${namePrefix}-ilb-fe')
          }
          frontendPort: 514
          loadDistribution: 'Default'
          probe: {
            id: resourceId('Microsoft.Network/loadBalancers/probes', '${namePrefix}-ilb', '${namePrefix}-ilb-hp')
          }
          protocol: 'Tcp'
        }
      }
    ]
    probes: [
      {
        name: '${namePrefix}-ilb-hp'
        properties: {
          intervalInSeconds: 5
          numberOfProbes: 2
          port: 514
          protocol: 'Tcp'
        }
      }
    ]
  }
}

// =========================
// Diagnostic Settings
// =========================

resource diagnosticSettingsLb 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = if(!empty(diagnosticSettings)) {
  name: '${namePrefix}-ilb-diag'
  scope: loadBalancer
  properties: {
    storageAccountId: diagnosticSettings.?storageAccountResourceId
    workspaceId: diagnosticSettings.?workspaceResourceId
    metrics: [
      {
        category: 'AllMetrics'
        enabled: true
      }
    ]
  }
}

@description('The backend address pools available in the load balancer.')
output backendpools array = loadBalancer.properties.backendAddressPools
