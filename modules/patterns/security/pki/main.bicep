targetScope = 'subscription'

// =========================
// Parameters test
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. Name of the resource group that will be created to host the pattern resources.')
param resourceGroupName string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

@description('Optional. An array of diagnostic settings to apply to applicable resources.')
param diagnosticSettings array = []

// Key Vault parameters
@description('Optional. Enable or disable the deployment of Root CA Key Vault.')
param deployRootCa bool = false

@description('Optional. Shared configuration for Key Vaults.')
param keyVaultConfigCommon keyVaultConfigCommonType = {
  enableSoftDelete: true
  enablePurgeProtection: true
}

@description('Optional. Private endpoint details for Key Vault.')
param keyVaultPrivateEndpoints array = []

@description('Optional. Array of role assignments to create for the Key Vaults.')
param keyVaultRoleAssignments array = []

// Existing Key Vault parameters
@description('Required. Key Vault hosting the PostgreSQL admin credentials.')
param keyVaultExisting keyVaultExistingType

// PostgreSQL parameters
@description('Required. Configuration for the PostgreSQL database.')
param postgresConfig postgresConfigType

@description('Required. Name of the Azure Kubernetes Service managed cluster.')
param aksClusterExisting aksClusterExistingType

@description('Optional. Password for PostgreSQL used for local testing.')
@secure()
param postgresAdminPassword string = ''

// =========================
// Resource Group(s)
// =========================

resource resourceGroup 'Microsoft.Resources/resourceGroups@2023-07-01' = {
  name: resourceGroupName
  location: location
  tags: tags
}

// =========================
// Existing Resources
// =========================

resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' existing = {
  name: keyVaultExisting.name
  scope: az.resourceGroup(keyVaultExisting.subscriptionId, keyVaultExisting.resourceGroupName)
}

resource aks 'Microsoft.ContainerService/managedClusters@2023-07-02-preview' existing = {
  name: aksClusterExisting.name
  scope: az.resourceGroup(aksClusterExisting.subscriptionId, aksClusterExisting.resourceGroupName)
}

// =========================
// Managed Identities
// =========================

@description('PKI User Managed Identity for Certificate Authority')
module pkiUserManagedIdentity 'br/public:avm/res/managed-identity/user-assigned-identity:0.2.1' = [
  for (certificateAuthorityName, i) in ['int', 'iss']: if (!deployRootCa) {
    name: '${deployment().name}-aks-management-pkiuai-${i+1}'
    scope: resourceGroup
    params: {
      name: 'aks-management-pkiuai-${certificateAuthorityName}'
      location: location
      enableTelemetry: false
      federatedIdentityCredentials: [
        for algorithm in ['rsa', 'ecdsa']: {
          name: '${algorithm}-${certificateAuthorityName}'
          issuer: aks.properties.oidcIssuerProfile.issuerURL
          subject: 'system:serviceaccount:smallstep-pki:${algorithm}-${certificateAuthorityName}'
          audiences: ['api://AzureADTokenExchange']
        }
      ]
    }
  }
]

// =========================
// Key Vaults
// =========================

// Root CA Key Vault
module rootKeyVault 'br/public:avm/res/key-vault/vault:0.4.0' = if (deployRootCa) {
  scope: resourceGroup
  name: '${deployment().name}-root-kv'
  params: {
    name: '${replace(namePrefix, '-','')}-rootkv'
    sku: 'premium'
    enableSoftDelete: keyVaultConfigCommon.enableSoftDelete
    enablePurgeProtection: keyVaultConfigCommon.enablePurgeProtection
    enableTelemetry: false
    diagnosticSettings: diagnosticSettings
    enableRbacAuthorization: true
    networkAcls: {
      defaultAction: 'deny'
    }
    tags: tags
  }
}

// Intermediate CA Key Vault
module intermediateKeyVault 'br/public:avm/res/key-vault/vault:0.4.0' = if (!deployRootCa) {
  scope: resourceGroup
  name: '${deployment().name}-int-kv'
  params: {
    name: '${replace(namePrefix, '-','')}int-kv'
    sku: 'premium'
    enableSoftDelete: keyVaultConfigCommon.enableSoftDelete
    enablePurgeProtection: keyVaultConfigCommon.enablePurgeProtection
    enableTelemetry: false
    diagnosticSettings: diagnosticSettings
    privateEndpoints: keyVaultPrivateEndpoints
    enableRbacAuthorization: true
    roleAssignments: [
      ...keyVaultRoleAssignments
      {
        roleDefinitionIdOrName: 'Key Vault Crypto User'
        principalId: pkiUserManagedIdentity[0].outputs.principalId
      }
    ]
    tags: tags
  }
}

// Issuing CA Key Vault
module issuingKeyVault 'br/public:avm/res/key-vault/vault:0.4.0' = if (!deployRootCa) {
  scope: resourceGroup
  name: '${deployment().name}-iss-kv'
  params: {
    name: '${replace(namePrefix, '-','')}iss-kv'
    sku: 'standard'
    enableSoftDelete: keyVaultConfigCommon.enableSoftDelete
    enablePurgeProtection: keyVaultConfigCommon.enablePurgeProtection
    enableTelemetry: false
    diagnosticSettings: diagnosticSettings
    privateEndpoints: keyVaultPrivateEndpoints
    enableRbacAuthorization: true
    roleAssignments: [
      ...keyVaultRoleAssignments
      {
        roleDefinitionIdOrName: 'Key Vault Crypto User'
        principalId: pkiUserManagedIdentity[1].outputs.principalId
      }
    ]
    tags: tags
  }
}

// =========================
// PostgreSQL
// =========================

module postgresDb 'br/public:avm/res/db-for-postgre-sql/flexible-server:0.1.3' = if (!deployRootCa && postgresConfig != null) {
  scope: resourceGroup
  name: '${deployment().name}-pgsql'
  params: {
    name: '${replace(namePrefix, '-','')}-pgsql'
    skuName: contains(postgresConfig, 'skuName') ? postgresConfig.skuName : 'Standard_B2s'
    tier: contains(postgresConfig, 'tier') ? postgresConfig.tier : 'Burstable'
    highAvailability: contains(postgresConfig, 'highAvailability') ? postgresConfig.highAvailability : 'Disabled'
    passwordAuth: contains(postgresConfig, 'passwordAuth') ? postgresConfig.passwordAuth : 'Disabled'
    administratorLogin: contains(postgresConfig, 'administratorLogin') ? postgresConfig.administratorLogin : ''
    administratorLoginPassword: !empty(postgresAdminPassword)
      ? postgresAdminPassword
      : keyVault.getSecret('postgreSqlAdminPassword-Common')
    administrators: contains(postgresConfig, 'administrators') ? postgresConfig.administrators : []
    databases: contains(postgresConfig, 'databases') ? postgresConfig.databases : []
    configurations: contains(postgresConfig, 'configurations') ? postgresConfig.configurations : []
    backupRetentionDays: contains(postgresConfig, 'backupRetentionDays') ? postgresConfig.backupRetentionDays : 7
    delegatedSubnetResourceId: contains(postgresConfig, 'delegatedSubnetResourceId')
      ? postgresConfig.delegatedSubnetResourceId
      : ''
    privateDnsZoneArmResourceId: contains(postgresConfig, 'privateDnsZoneArmResourceId')
      ? postgresConfig.privateDnsZoneArmResourceId
      : ''
    diagnosticSettings: diagnosticSettings
    roleAssignments: contains(postgresConfig, 'roleAssignments') ? postgresConfig.roleAssignments : []
    enableTelemetry: false
    tags: tags
  }
}

// =========================
// User-Defined Types
// =========================

type postgresConfigType = {
  @description('Optional. The name of the sku, typically, tier + family + cores, e.g. Standard_D4s_v3.')
  skuName: string?

  @description('Optional. The tier of the particular SKU. Tier must align with the \'skuName\' property. Example, tier cannot be \'Burstable\' if skuName is \'Standard_D4s_v3\'.')
  tier: 'GeneralPurpose' | 'Burstable' | 'MemoryOptimized'?

  @description('Optional. The mode for high availability.')
  highAvailability: 'Disabled' | 'SameZone' | 'ZoneRedundant'?

  @description('Optional. If Enabled, password authentication is enabled.')
  passwordAuth: 'Disabled' | 'Enabled' | null

  @description('Optional. The administrator login name of a server. Required when sqlPasswordAuth is "enabled". Can only be specified when the PostgreSQL server is being created.')
  administratorLogin: string?

  @description('Optional. The Azure AD administrators when AAD authentication enabled.')
  administrators: array?

  @description('Optional. The databases to create in the server.')
  databases: array?

  @description('Optional. The configurations to create in the server.')
  configurations: array?

  @description('Optional. Backup retention days for the server.')
  backupRetentionDays: int?

  @description('Optional. Delegated subnet arm resource ID for Postgres Server. Used when the desired connectivity mode is \'Private Access\' - virtual network integration.')
  delegatedSubnetResourceId: string?

  @description('Optional. Private dns zone arm resource ID for Postgres Server. Used when the desired connectivity mode is \'Private Access\' and required when \'delegatedSubnetResourceId\' is used. The Private DNS Zone must be lined to the Virtual Network referenced in \'delegatedSubnetResourceId\'.')
  privateDnsZoneArmResourceId: string?

  @description('Optional. RBAC role assignments associated to the PostgreSQL server.')
  roleAssignments: array?

  @description('Optional. The Name of the PostgreSQL admin password secret in the Key Vault.')
  postgreSqlAdminKeyVaultSecretName: string?
}?

type keyVaultConfigCommonType = {
  @description('Required. Is Soft Delete enabled for the Key Vault.')
  enableSoftDelete: bool

  @description('Required. Is Purge Protection enabled for the Key Vault - Default length is 7 days.')
  enablePurgeProtection: bool
}

type keyVaultExistingType = {
  @description('Required. The name of the Key Vault.')
  name: string

  @description('Required. The name of the resource group that contains the Key Vault.')
  resourceGroupName: string

  @description('Required. The ID of the subscription where the Key Vault is located.')
  subscriptionId: string
}

type aksClusterExistingType = {
  @description('Required. The name of the Azure Kubernetes Service.')
  name: string

  @description('Required. The name of the resource group that contains the Azure Kubernetes Service.')
  resourceGroupName: string

  @description('Required. The ID of the subscription where the Azure Kubernetes Service is located.')
  subscriptionId: string
}
