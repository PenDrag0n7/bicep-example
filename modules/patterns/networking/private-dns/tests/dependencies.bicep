// =========================
// Parameters
// =========================

@description('Optional. The location to deploy to.')
param location string = resourceGroup().location

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

// =========================
// Virtual Networks
// =========================

module hubVirtualNetwork '../../../../resources/network/virtual-network/main.bicep' = {
  name: '${deployment().name}-hub'
  params: {
    name: '${namePrefix}-vnet'
    location: location
    addressPrefixes: ['10.68.0.0/21']
    subnets: [
      {
        name: 'sn-priv-link'
        addressPrefix: '10.68.0.0/27'
        assignNsg: true
      }
      {
        name: 'sn-dns-in'
        addressPrefix: '10.68.1.32/27'
        assignNsg: true
        delegations: [
          {
            name: 'Microsoft.Network/dnsResolvers'
            properties: {
              serviceName: 'Microsoft.Network/dnsResolvers'
            }
          }
        ]
      }
      {
        name: 'sn-dns-out'
        addressPrefix: '10.68.2.64/27'
        assignNsg: true
        delegations: [
          {
            name: 'Microsoft.Network/dnsResolvers'
            properties: {
              serviceName: 'Microsoft.Network/dnsResolvers'
            }
          }
        ]
      }
    ]
  }
}

module spokeVirtualNetwork '../../../../resources/network/virtual-network/main.bicep' = {
  name: '${deployment().name}-spoke'
  params: {
    name: '${namePrefix}-spoke-vnet'
    location: location
    addressPrefixes: ['10.68.8.0/21']
    dnsServers: ['10.68.1.36']
    subnets: [
      {
        name: 'spoke-subnet'
        addressPrefix: '10.68.8.0/27'
        assignNsg: true
      }
    ]
    peerings: [
      {
        remoteVirtualNetworkId: hubVirtualNetwork.outputs.resourceId
        allowForwardedTraffic: true
        allowGatewayTransit: false
        allowVirtualNetworkAccess: true
        remotePeeringAllowForwardedTraffic: true
        remotePeeringAllowVirtualNetworkAccess: true
        remotePeeringEnabled: true
        useRemoteGateways: false
      }
    ]
  }
}
