// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

// Module specific parameters
@description('Required. Configuration object for the Fortigate resources.')
param fortiGateConfig object

@description('Required. Existing Virtual Network that will host the networking resources.')
param vnetExisting object

@description('Optional. Enable Diagnostic Settings for supported resources.')
param diagnosticSettings array = []

// =========================
// Load Balancer - Backend
// =========================

resource loadBalancer 'Microsoft.Network/loadBalancers@2023-09-01' = {
  name: '${namePrefix}-fortigate-ilb'
  location: location
  sku: {
    name: 'Standard'
  }
  properties: {
    frontendIPConfigurations: [for zone in fortiGateConfig.loadBalancerZones: {
      properties: {
        subnet: {
          id: resourceId(subscription().subscriptionId, vnetExisting.resourceGroupName, 'Microsoft.Network/virtualNetworks/subnets', vnetExisting.name, zone.subnet)
        }
        privateIPAddress: zone.ilbIpAddress
        privateIPAllocationMethod: 'Static'
      }
      name: '${namePrefix}-${zone.name}-ilb-fe'
      zones: [
        '1', '2'
      ]
    }]
    backendAddressPools: [for zone in fortiGateConfig.loadBalancerZones: {
      name: '${namePrefix}-${zone.name}-ilb-bp'
    }]
    loadBalancingRules: [for zone in fortiGateConfig.loadBalancerZones: {
      properties: {
        frontendIPConfiguration: {
          id: resourceId('Microsoft.Network/loadBalancers/frontendIpConfigurations', '${namePrefix}-fortigate-ilb', '${namePrefix}-${zone.name}-ilb-fe')
        }
        backendAddressPool: {
          id: resourceId('Microsoft.Network/loadBalancers/backendAddressPools', '${namePrefix}-fortigate-ilb', '${namePrefix}-${zone.name}-ilb-bp')
        }
        probe: {
          id: resourceId('Microsoft.Network/loadBalancers/probes', '${namePrefix}-fortigate-ilb', '${namePrefix}-${zone.name}-ilb-hp')
        }
        protocol: 'All'
        frontendPort: 0
        backendPort: 0
        disableOutboundSnat: true
        enableFloatingIP: false
        enableTcpReset: false
        loadDistribution: 'SourceIPProtocol'
        idleTimeoutInMinutes: 4
      }
      name: '${namePrefix}-${zone.name}-ilb-lb'
    }]
    probes: [for zone in fortiGateConfig.loadBalancerZones: {
      properties: {
        intervalInSeconds: 5
        numberOfProbes: 5
        port: 117
        protocol: 'Http'
        requestPath: '/'
      }
      name: '${namePrefix}-${zone.name}-ilb-hp'
    }]
  }
  tags: tags
}

// =========================
// Diagnostic Settings
// =========================

resource diagnosticSettingsLb 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = [for diagnosticSetting in diagnosticSettings: {
  name: diagnosticSetting.name
  scope: loadBalancer
  properties: {
    storageAccountId: diagnosticSetting.?storageAccountResourceId
    workspaceId: diagnosticSetting.?workspaceResourceId
    metrics: [
      {
        category: 'AllMetrics'
        enabled: true
      }
    ]
  }
}]
