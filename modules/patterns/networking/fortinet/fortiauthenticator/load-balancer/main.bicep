// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

// Module specific parameters
@description('Required. Configuration object for the Fortigate resources.')
param fortiAuthenticatorConfig object

@description('Required. Existing Virtual Network that will host the networking resources.')
param vnetExisting object

@description('Optional. Enable Diagnostic Settings for supported resources.')
param diagnosticSettings array = []

// =========================
// Load Balancer
// =========================

resource loadBalancer 'Microsoft.Network/loadBalancers@2023-04-01' = {
  name: '${namePrefix}-fortiauthenticator-ilb'
  location: location
  sku: {
    name: 'Standard'
  }
  properties: {
    backendAddressPools: [
      { name: '${namePrefix}-fortiauthenticator-ilb-bp' }
    ]
    frontendIPConfigurations: [
      {
        name: '${namePrefix}-fortiauthenticator-ilb-fe'
        properties: {
          subnet: {
            id: resourceId(subscription().subscriptionId, vnetExisting.resourceGroupName, 'Microsoft.Network/virtualNetworks/subnets', vnetExisting.name, fortiAuthenticatorConfig.loadBalancerConfig.subnet)
          }
          privateIPAddress: fortiAuthenticatorConfig.loadBalancerConfig.ipAddress
          privateIPAllocationMethod: 'Static'
        }
      }
    ]
    loadBalancingRules: [
      {
        name: '${namePrefix}-fortiauthenticator-ilb-lb'
        properties: {
          frontendIPConfiguration: {
            id: resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', '${namePrefix}-fortiauthenticator-ilb', '${namePrefix}-fortiauthenticator-ilb-fe')
          }
          backendAddressPool: {
            id: resourceId('Microsoft.Network/loadBalancers/backendAddressPools', '${namePrefix}-fortiauthenticator-ilb', '${namePrefix}-fortiauthenticator-ilb-bp')
          }
          probe: {
            id: resourceId('Microsoft.Network/loadBalancers/probes', '${namePrefix}-fortiauthenticator-ilb', '${namePrefix}-fortiauthenticator-ilb-hp')
          }
          protocol: 'Tcp'
          backendPort: 443
          frontendPort: 443
          loadDistribution: 'Default'
        }
      }
    ]
    probes: [
      {
        name: '${namePrefix}-fortiauthenticator-ilb-hp'
        properties: {
          intervalInSeconds: 5
          numberOfProbes: 2
          port: 443
          protocol: 'Tcp'
        }
      }
    ]
  }
  tags: tags
}

// =========================
// Diagnostic Settings
// =========================

resource diagnosticSettingsLb 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = [for diagnosticSetting in diagnosticSettings: {
  name: diagnosticSetting.name
  scope: loadBalancer
  properties: {
    storageAccountId: diagnosticSetting.?storageAccountResourceId
    workspaceId: diagnosticSetting.?workspaceResourceId
    metrics: [
      {
        category: 'AllMetrics'
        enabled: true
      }
    ]
  }
}]
