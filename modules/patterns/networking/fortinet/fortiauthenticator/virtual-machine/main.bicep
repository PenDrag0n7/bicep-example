// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

// Module specific parameters
@description('Required. Common configuration for the FortiAuthenticator resources.')
param fortiAuthenticatorConfig object

@description('Required. Instance configuration object.')
param instanceConfig object

@description('Required. Existing Virtual Network that will host the networking resources.')
param vnetExisting object

@description('Required. Virtual Machine admin username, extracted from a zone-centric Key Vault.')
@secure()
param vmAdminUsername string

@description('Required. Virtual Machine admin password, extracted from a zone-centric Key Vault.')
@secure()
param vmAdminPassword string

@description('Optional. Enable Diagnostic Settings for supported resources.')
param diagnosticSettings array = []

// FortiAuthenticator Image Reference
var imageReference = {
  publisher: 'fortinet'
  offer: 'fortinet-fortiauthenticator-vm'
  sku: 'fortinet-fac-vm'
  version: '6.0.2'
}

// =========================
// Virtual NIC
// =========================

module vmNetworkInterface 'br/public:avm/res/network/network-interface:0.2.4' =  {
  name: '${deployment().name}-nic'
  params: {
    name: '${instanceConfig.name}-nic-mgmt-01'
    enableAcceleratedNetworking: fortiAuthenticatorConfig.?enableAcceleratedNetworking ?? true
    diagnosticSettings: [for diagnosticSetting in diagnosticSettings: {
        name: diagnosticSetting.name
        storageAccountResourceId: diagnosticSetting.?storageAccountResourceId
        workspaceResourceId: diagnosticSetting.?workspaceResourceId
      }
    ]
    ipConfigurations: [
      {
        name: 'mgmt-ipconfig-01'
        privateIPAllocationMethod: 'Static'
        privateIPAddressVersion: 'IPv4'
        privateIPAddress: instanceConfig.ipAddresses.mgmt
        subnetResourceId: resourceId(subscription().subscriptionId, vnetExisting.resourceGroupName, 'Microsoft.Network/virtualNetworks/subnets', vnetExisting.name, 'sn-mgmt')
        loadBalancerBackendAddressPools: [
          {
            id: resourceId(subscription().subscriptionId, resourceGroup().name, 'Microsoft.Network/loadBalancers/backendAddressPools', '${namePrefix}-fortiauthenticator-ilb', '${namePrefix}-fortiauthenticator-ilb-bp')
          }
        ]
      }
    ]
    tags: tags
  }
}

// =========================
// Virtual Machine
// =========================

resource fortiAuthVM 'Microsoft.Compute/virtualMachines@2023-09-01' = {
  name: instanceConfig.name
  location: location
  zones: [
    instanceConfig.availabilityZone
  ]
  plan: {
    name: imageReference.sku
    publisher: imageReference.publisher
    product: imageReference.offer
  }
  properties: {
    hardwareProfile: {
      vmSize: fortiAuthenticatorConfig.vmSize
    }
    networkProfile: {
      networkInterfaces: [
        {
          id: vmNetworkInterface.outputs.resourceId
        }
      ]
    }
    osProfile: {
      adminUsername: vmAdminUsername
      adminPassword: vmAdminPassword
      computerName: instanceConfig.name
    }
    storageProfile: {
      imageReference: imageReference
      osDisk: {
        // osType: 'Linux'
        name: '${instanceConfig.name}-disk-os'
        createOption: 'FromImage'
        caching: 'ReadWrite'
        deleteOption: 'Detach'
      }
      dataDisks: [
        {
          lun: 0
          createOption: 'FromImage'
          caching: 'ReadWrite'
          deleteOption: 'Detach'
          name: '${instanceConfig.name}-disk-data-01'
        }
      ]
    }
    diagnosticsProfile: {
      bootDiagnostics: {
        enabled: true
      }
    }
  }
  tags: tags
}
