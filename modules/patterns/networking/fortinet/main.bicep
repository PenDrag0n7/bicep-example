targetScope = 'subscription'

metadata name = 'Pattern - Fortinet Stack'
metadata description = 'Deploys the components required for the Fortinet suite of firewall appliances.'
metadata owner = 'Platform team'

// =========================
// Parameters
// =========================

// Common parameters
@description('Required. Azure region to deploy the resources into. E.g. "australiaeast".')
param location string

@description('Required. The prefix to use for naming conventions, typically generated by the ESLZ conventions module.')
param namePrefix string

@description('Optional. A list of tags to be associated with each resource for traceability.')
param tags object = {}

// Module specific parameters
@description('Required: The name of the Virtual Network that contains the subnets for the Virtual Machines.')
param vnetExisting object

@description('Required. Key Vault hosting the Virtual Machine admin credentials.')
param keyVaultExisting object

@description('Required. Location of the existing Public IP Prefix located in the Hub zone.')
param publicIpPrefixExisting object

// Fortinet component configuration blocks
@description('Optional. Deploy and configure the fortiManager Nodes.')
param fortiManagerConfig object = { enabled: false }

@description('Optional. Deploy and configure the fortiGate Nodes.')
param fortiGateConfig object = { enabled: false }

@description('Optional. Deploy and configure the fortiWeb Nodes.')
param fortiWebConfig object = { enabled: false }

@description('Optional. Deploy and configure the fortiAnalyzer Nodes.')
param fortiAnalyzerConfig object = { enabled: false }

@description('Optional. Deploy and configure the fortiAuthenticator Nodes.')
param fortiAuthenticatorConfig object = { enabled: false }

@description('Optional. Deploy and configure the fortiWebManager Nodes.')
param fortiWebManagerConfig object = { enabled: false }

@description('Optional. Enable Diagnostic Settings for supported resources.')
param diagnosticSettings array = []

@description('Optional. Existing Private DNS Zone that will host the A Records for the Management Interface IP.')
param privateDnsZoneExisting object = {}

// =========================
// Existing Resources
// =========================

// Shared Key Vault
resource keyVault 'Microsoft.KeyVault/vaults@2023-02-01' existing = {
  name: keyVaultExisting.name
  scope: resourceGroup(keyVaultExisting.resourceGroupName)
}

// Public IP Prefix
resource publicIpPrefix 'Microsoft.Network/publicIPPrefixes@2023-09-01' existing = {
  name: publicIpPrefixExisting.name
  scope: resourceGroup(publicIpPrefixExisting.resourceGroupName)
}

// =========================
// FortiAnalyzer
// =========================

module fortiAnalyzer 'fortianalyzer/main.bicep' = if (fortiAnalyzerConfig.?enabled ?? false) {
  name: '${deployment().name}-fana'
  params: {
    location: location
    namePrefix: namePrefix
    vnetExisting: vnetExisting
    vmAdminUsername: keyVault.getSecret('vmAdminUsername-Common')
    vmAdminPassword: keyVault.getSecret('vmAdminPassword-Common')
    fortiAnalyzerConfig: fortiAnalyzerConfig
    privateDnsZoneExisting: privateDnsZoneExisting
    diagnosticSettings: diagnosticSettings
    tags: tags
  }
}

// =========================
// FortiAuthenticator
// =========================

module fortiAuthenticator 'fortiauthenticator/main.bicep' = if (fortiAuthenticatorConfig.?enabled ?? false) {
  name: '${deployment().name}-fauth'
  params: {
    location: location
    namePrefix: namePrefix
    vnetExisting: vnetExisting
    vmAdminUsername: keyVault.getSecret('vmAdminUsername-Common')
    vmAdminPassword: keyVault.getSecret('vmAdminPassword-Common')
    fortiAuthenticatorConfig: fortiAuthenticatorConfig
    privateDnsZoneExisting: privateDnsZoneExisting
    diagnosticSettings: diagnosticSettings
    tags: tags
  }
}

// =========================
// FortiGate
// =========================

module fortiGate 'fortigate/main.bicep' = if (fortiGateConfig.?enabled ?? false) {
  name: '${deployment().name}-fgate'
  params: {
    location: location
    namePrefix: namePrefix
    vnetExisting: vnetExisting
    vmAdminUsername: keyVault.getSecret('vmAdminUsername-Common')
    vmAdminPassword: keyVault.getSecret('vmAdminPassword-Common')
    fortiGateConfig: fortiGateConfig
    ipPrefixResourceId: publicIpPrefix.id
    privateDnsZoneExisting: privateDnsZoneExisting
    diagnosticSettings: diagnosticSettings
    tags: tags
  }
}

// =========================
// FortiManager
// =========================

module fortiManager 'fortimanager/main.bicep' = if (fortiManagerConfig.?enabled ?? false) {
  name: '${deployment().name}-fmgr'
  params: {
    location: location
    namePrefix: namePrefix
    vnetExisting: vnetExisting
    vmAdminUsername: keyVault.getSecret('vmAdminUsername-Common')
    vmAdminPassword: keyVault.getSecret('vmAdminPassword-Common')
    fortiManagerConfig: fortiManagerConfig
    privateDnsZoneExisting: privateDnsZoneExisting
    diagnosticSettings: diagnosticSettings
    tags: tags
  }
}

// =========================
// FortiWeb
// =========================

module fortiWeb 'fortiweb/main.bicep' = if (fortiWebConfig.?enabled ?? false) {
  name: '${deployment().name}-fweb'
  params: {
    location: location
    namePrefix: namePrefix
    vnetExisting: vnetExisting
    vmAdminUsername: keyVault.getSecret('vmAdminUsername-Common')
    vmAdminPassword: keyVault.getSecret('vmAdminPassword-Common')
    fortiWebConfig: fortiWebConfig
    publicIpPrefixResourceId: publicIpPrefix.id
    privateDnsZoneExisting: privateDnsZoneExisting
    diagnosticSettings: diagnosticSettings
    tags: tags
  }
}

// =========================
// FortiWeb Manager
// =========================

module fortiWebManager 'fortiwebmanager/main.bicep' = if (fortiWebManagerConfig.?enabled ?? false) {
  name: '${deployment().name}-fwebmgr'
  params: {
    location: location
    namePrefix: namePrefix
    vnetExisting: vnetExisting
    vmAdminUsername: keyVault.getSecret('vmAdminUsername-Common')
    vmAdminPassword: keyVault.getSecret('vmAdminPassword-Common')
    fortiWebManagerConfig: fortiWebManagerConfig
    privateDnsZoneExisting: privateDnsZoneExisting
    diagnosticSettings: diagnosticSettings
    tags: tags
  }
}
